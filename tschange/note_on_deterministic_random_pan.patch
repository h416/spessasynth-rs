+// Deterministic PRNG based on currentTime (matching Rust implementation)
+const _f64Buf = new Float64Array(1);
+const _f64View = new DataView(_f64Buf.buffer);
+function deterministicRandomPan(time: number): number {
+    _f64Buf[0] = time;
+    const bits = _f64View.getBigUint64(0, true); // little-endian to match Rust f64::to_bits()
+    const h = BigInt.asUintN(64,
+        BigInt.asUintN(64, bits * 6364136223846793005n) + 1442695040888963407n
+    );
+    const normalized = Number(h >> 33n) / 0xFFFFFFFF;
+    return Math.round(normalized * 1000 - 500);
+}
